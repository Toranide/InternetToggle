<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>InternetToggle</Product>
    <RepositoryUrl>https://github.com/Toranide/InternetToggle</RepositoryUrl>
    <Description>A lightweight Windows system-tray utility for toggling a selected network adapter.</Description>
    <Authors>Toranide</Authors>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="connected.png" />
    <None Remove="disconnected.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="connected.png" />
    <EmbeddedResource Include="disconnected.png" />
  </ItemGroup>

</Project>
